{
  "realm": "edu-app",
  "enabled": true,
  "displayName": "EDU APP",
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "verifyEmail": false,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Default learner",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "teacher",
        "description": "Coach / teacher (maps to TEACHER)",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "admin",
        "description": "Administrator",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "defaultRoles": ["user"],
  "clientScopes": [
    {
      "name": "edu-app-roles",
      "description": "Flat app_roles claim for BFF role mapping (interview lab)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "app-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "app_roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "nihongo-web",
      "name": "Nihongo Web (React)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://nihongo.localhost:8080/*",
        "http://localhost:8080/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "edu-app-roles"
      ],
      "optionalClientScopes": ["address", "phone", "offline_access"]
    },
    {
      "clientId": "nihongo-angular",
      "name": "Nihongo Angular",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://nihongo-angular.localhost:8080/*",
        "http://localhost:4200/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "edu-app-roles"
      ],
      "optionalClientScopes": ["address", "phone", "offline_access"]
    },
    {
      "clientId": "nihongo-mobile",
      "name": "Nihongo Mobile (Flutter/Android/iOS/Expo)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "redirectUris": [
        "nihongo://auth/callback",
        "com.edu.nihongo:/oauth2redirect",
        "com.edu.nihongo_app:/oauth2redirect",
        "com.edu.nihongo.ios:/oauth2redirect"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "edu-app-roles"
      ],
      "optionalClientScopes": ["address", "phone", "offline_access"]
    }
  ],
  "users": [
    {
      "username": "demo",
      "email": "demo@nihongo.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "demo123",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    },
    {
      "username": "coach",
      "email": "coach@nihongo.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Coach",
      "lastName": "Teacher",
      "credentials": [
        {
          "type": "password",
          "value": "coach123",
          "temporary": false
        }
      ],
      "realmRoles": ["teacher", "user"]
    },
    {
      "username": "admin-kc",
      "email": "admin-kc@nihongo.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "Keycloak",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "user"]
    }
  ]
}
