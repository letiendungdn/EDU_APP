# Docker Compose — copy to .env and chỉnh nếu cần
POSTGRES_PASSWORD=nihongo
ENGLISH_POSTGRES_PASSWORD=english
# Stack Nihongo-only (mặc định): false — không cần postgres-english
# Full stack: docker compose --profile english up -d và đặt ENGLISH_ENABLED=true
ENGLISH_ENABLED=false
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
ADMIN_EMAIL=admin@nihongo.local
ADMIN_PASSWORD=admin123
# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_ISSUER=http://auth.localhost:8080/realms/edu-app
KEYCLOAK_REALM=edu-app
NEXT_PUBLIC_KEYCLOAK_URL=http://auth.localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=edu-app
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=nihongo-web
NEXT_PUBLIC_KEYCLOAK_ANGULAR_CLIENT_ID=nihongo-angular
# Nginx host port (tránh bind :80 — đổi nếu 8080 bị chiếm)
NGINX_HTTP_PORT=8080
ALLOWED_ORIGINS=http://localhost:8080,http://nihongo.localhost:8080,http://nihongo-angular.localhost:8080,http://auth.localhost:8080,http://english.localhost:8080,http://localhost:5173,http://localhost:5174,http://localhost:3001
NEXT_PUBLIC_SIGNALING_URL=http://localhost:3002
SIGNALING_CORS_ORIGIN=http://localhost:8080,http://localhost:5173,http://nihongo.localhost:8080
NEXT_PUBLIC_ENGLISH_APP_URL=http://english.localhost:8080
NEXT_PUBLIC_NIHONGO_APP_URL=http://nihongo.localhost:8080

# Brevo transactional email (optional — empty = noop logger)
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
MAIL_FROM_EMAIL=noreply@your-verified-domain.com
MAIL_FROM_NAME=Nihongo EDU
APP_PUBLIC_URL=http://nihongo.localhost:8080
UNSUBSCRIBE_SECRET=
MAIL_VERIFY_EMAIL_PATH=/verify-email
MAIL_VERIFY_EXPIRES_MINUTES=1440
MAIL_RESET_EXPIRES_MINUTES=30
