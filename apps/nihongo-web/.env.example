# API backend URL (used by Next.js rewrites)
API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
# Google Sign-In (OAuth 2.0 Client ID — Web application)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Stripe publishable key (pk_test_... for test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# WebRTC signaling server (video call)
NEXT_PUBLIC_SIGNALING_URL=http://localhost:3002
# Mapbox GL (public token — https://account.mapbox.com)
NEXT_PUBLIC_MAPBOX_TOKEN=
# Keycloak OIDC (browser)
NEXT_PUBLIC_KEYCLOAK_URL=http://auth.localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=edu-app
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=nihongo-web
