# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# MongoDB
MONGODB_URL=mongodb://localhost:27017/nihongo_audit

# Kafka
KAFKA_BROKERS=localhost:9092

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=edu-app-dev

# Redis
REDIS_URL=redis://localhost:6379

# Database (Nihongo)
DATABASE_URL=postgresql://nihongo:nihongo@localhost:5433/nihongo

# Database (English) — container postgres-english, port host 5434
# Tắt module English khi chỉ học JP: ENGLISH_ENABLED=false
ENGLISH_ENABLED=true
ENGLISH_DATABASE_URL=postgresql://english:english@localhost:5434/english_learning

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

# Keycloak (OIDC → local JWT exchange)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ISSUER=http://auth.localhost:8080/realms/edu-app
KEYCLOAK_REALM=edu-app

# Google OAuth (cùng Client ID cho frontend + backend)
GOOGLE_CLIENT_ID=

# Brevo transactional email (empty BREVO_API_KEY → noop)
BREVO_API_KEY=
MAIL_FROM_EMAIL=noreply@nihongo.local
MAIL_FROM_NAME=Nihongo EDU
APP_PUBLIC_URL=http://nihongo.localhost:8080
MAIL_RESET_EXPIRES_MINUTES=30
